{
  "name": "niemis-backend",
  "version": "1.0.0",
  "description": "National Integrated Education Management Information System - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "render:start": "NODE_ENV=production npm run migrate && npm run start",
    "build": "echo 'Backend build complete - NiEMIS API Server'",
    "dev": "nodemon server.js",
    "test": "jest --runInBand test/smoke",
    "test:legacy": "jest --runInBand",
    "test:api": "jest --runInBand --verbose test/api",
    "test:database": "jest --runInBand test/database",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "migrate:undo:all": "npx sequelize-cli db:migrate:undo:all",
    "seed": "npx sequelize-cli db:seed:all",
    "seed:dashboard": "node scripts/seed-dashboard-mock-data.js",
    "seed:classroom-grades": "node scripts/seed-classroom-grades.js",
    "sync:class-enrollment": "node scripts/sync-school-class-enrollment.js",
    "seed:undo": "npx sequelize-cli db:seed:undo:all",
    "seed:production": "node scripts/import-barbados-schools.js",
    "db:setup": "npm run migrate && npm run seed:production",
    "db:reset": "npm run migrate:undo:all && npm run migrate && npm run seed:production",
    "backup": "node scripts/backup-database.js backup",
    "restore": "node scripts/backup-database.js restore",
    "backup:list": "node scripts/backup-database.js list",
    "health:check": "node scripts/database-health-check.js",
    "import:schools": "node scripts/import-barbados-schools.js",
    "create:demo": "node scripts/create-demo-students.js",
    "validate:deployment": "node scripts/validate-deployment.js",
    "postinstall": "echo 'Installation complete. Run npm run migrate manually if needed.'",
    "deploy": "npm run db:setup && npm run validate:deployment",
    "production:start": "NODE_ENV=production node server.js",
    "production:test": "NODE_ENV=production npm run test",
    "logs:error": "tail -f logs/error.log",
    "logs:combined": "tail -f logs/combined.log",
    "security:audit": "npm audit --audit-level moderate",
    "security:fix": "npm audit fix",
    "lint": "node --check server.js && node --check routes/teachers.js && node --check seedGradingData.js",
    "prestart": "echo 'Starting NiEMIS Backend API Server...'"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "glob": "^10.3.10",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.4",
    "pdfkit": "^0.17.2",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "rimraf": "^5.0.5",
    "sequelize": "^6.32.1",
    "socket.io": "^4.7.4",
    "sqlite3": "^5.1.7",
    "twilio": "^4.14.0",
    "uuid": "^9.0.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "sequelize-cli": "^6.6.1",
    "supertest": "^7.1.3"
  },
  "keywords": [
    "education",
    "management",
    "barbados",
    "emis"
  ],
  "author": "Ministry of Educational Transformation - Barbados",
  "license": "MIT",
  "overrides": {
    "rimraf": "^5.0.5",
    "glob": "^10.3.10",
    "superagent": "^10.2.2",
    "are-we-there-yet": "^4.0.2",
    "npmlog": "^7.0.1",
    "gauge": "^5.0.1",
    "fstream": false,
    "inflight": "^1.0.6",
    "@npmcli/move-file": "^3.0.3",
    "lodash.isequal": false,
    "exceljs": {
      "fast-csv": "^5.0.1",
      "unzipper": "^0.12.3",
      "lodash.isequal": false,
      "fstream": false
    },
    "fast-csv": {
      "lodash.isequal": false
    },
    "unzipper": {
      "fstream": false
    },
    "*": {
      "lodash.isequal": false,
      "fstream": false
    },
    "**": {
      "lodash.isequal": false,
      "fstream": false,
      "inflight": false,
      "rimraf": "^5.0.5",
      "glob": "^10.3.10"
    }
  },
  "resolutions": {
    "lodash.isequal": false,
    "fstream": false,
    "**/lodash.isequal": false,
    "**/fstream": false,
    "**/rimraf": "^5.0.5",
    "**/glob": "^10.3.10"
  }
}
