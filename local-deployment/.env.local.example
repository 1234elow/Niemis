# NiEMIS Backend Local Development Environment Configuration

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# Local PostgreSQL Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=niemis_local
DB_USER=niemis_user
DB_PASSWORD=local_password123

# Database Connection Pool Settings
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=10000

# ==============================================
# SERVER CONFIGURATION
# ==============================================
# Development server settings
NODE_ENV=development
PORT=5000

# Enable detailed logging for development
DB_LOGGING=true
DEBUG=niemis:*

# ==============================================
# AUTHENTICATION & SECURITY
# ==============================================
# JWT Configuration for development (longer expiration)
JWT_SECRET=your_super_secret_jwt_key_for_local_development_change_this_in_production
JWT_EXPIRE_TIME=24h
JWT_REFRESH_EXPIRE_TIME=7d

# Session configuration
SESSION_SECRET=your_session_secret_for_local_development

# ==============================================
# CORS CONFIGURATION
# ==============================================
# Allow local development origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000
CORS_CREDENTIALS=true

# ==============================================
# RATE LIMITING (Relaxed for development)
# ==============================================
# General rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Authentication rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=50

# ==============================================
# FILE UPLOAD CONFIGURATION
# ==============================================
# Local file upload settings
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_MAX_FILES=10
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx

# ==============================================
# HTTPS CONFIGURATION (Optional for development)
# ==============================================
# Set to true if you want to test HTTPS locally
HTTPS_ENABLED=false
HTTPS_PORT=8443

# SSL Certificate paths (if using HTTPS)
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem

# ==============================================
# EXTERNAL SERVICES (Optional for development)
# ==============================================
# Email configuration (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@niemis.local

# SMS Configuration (optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ==============================================
# DEVELOPMENT TOOLS
# ==============================================
# Enable hot reload for development
HOT_RELOAD=true

# Enable development middleware
ENABLE_CORS=true
ENABLE_MORGAN_LOGGING=true
ENABLE_PRETTY_ERRORS=true

# ==============================================
# MONITORING & HEALTH CHECKS
# ==============================================
# Health check configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_DB_TIMEOUT=5000

# Performance monitoring
PERFORMANCE_MONITORING=true
QUERY_PERFORMANCE_LOGGING=true

# ==============================================
# SECURITY SETTINGS (Development)
# ==============================================
# Content Security Policy (relaxed for development)
CSP_ENABLED=false

# Helmet security headers (relaxed for development)
HELMET_HSTS_MAX_AGE=0
HELMET_HSTS_INCLUDE_SUBDOMAINS=false

# ==============================================
# BACKUP CONFIGURATION
# ==============================================
# Local backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_PATH=./backups

# ==============================================
# FEATURE FLAGS (Development)
# ==============================================
# Enable/disable features for development
FEATURE_RFID_ENABLED=true
FEATURE_SMS_NOTIFICATIONS=false
FEATURE_EMAIL_NOTIFICATIONS=false
FEATURE_AUDIT_LOGGING=true
FEATURE_PERFORMANCE_MONITORING=true

# ==============================================
# TESTING CONFIGURATION
# ==============================================
# Test database settings
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=niemis_test
TEST_DB_USER=niemis_user
TEST_DB_PASSWORD=local_password123

# ==============================================
# DEBUGGING & DEVELOPMENT
# ==============================================
# Debug levels
DEBUG_LEVEL=info
LOG_LEVEL=debug

# Enable development tools
ENABLE_GRAPHQL_PLAYGROUND=true
ENABLE_API_DOCS=true
ENABLE_QUERY_DEBUGGER=true

# ==============================================
# NETWORK CONFIGURATION
# ==============================================
# Allow access from local network
BIND_HOST=0.0.0.0
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.*,10.*,172.16.*

# ==============================================
# CACHE CONFIGURATION
# ==============================================
# Redis configuration (optional for development)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Memory cache settings
MEMORY_CACHE_ENABLED=true
MEMORY_CACHE_TTL=3600