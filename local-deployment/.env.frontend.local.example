# NiEMIS Frontend Local Development Environment Configuration

# ==============================================
# API CONFIGURATION
# ==============================================
# Local backend API URL
VITE_API_URL=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000/api

# WebSocket configuration (if using real-time features)
VITE_WS_URL=ws://localhost:5000

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
# Application metadata
VITE_APP_NAME=NiEMIS
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=National Integrated Education Management Information System

# Environment settings
VITE_NODE_ENV=development
VITE_DEBUG=true

# ==============================================
# AUTHENTICATION CONFIGURATION
# ==============================================
# JWT token settings for frontend
VITE_JWT_STORAGE_KEY=niemis_auth_token
VITE_JWT_REFRESH_STORAGE_KEY=niemis_refresh_token

# Session timeout (in minutes)
VITE_SESSION_TIMEOUT=1440

# ==============================================
# FEATURE FLAGS
# ==============================================
# Enable/disable features in development
VITE_FEATURE_RFID_ENABLED=true
VITE_FEATURE_NOTIFICATIONS_ENABLED=true
VITE_FEATURE_ANALYTICS_ENABLED=true
VITE_FEATURE_DARK_MODE_ENABLED=true
VITE_FEATURE_MOBILE_RESPONSIVE=true

# ==============================================
# UI CONFIGURATION
# ==============================================
# Theme settings
VITE_THEME_PRIMARY_COLOR=#1976d2
VITE_THEME_SECONDARY_COLOR=#dc004e
VITE_DEFAULT_LANGUAGE=en

# Layout configuration
VITE_SIDEBAR_DEFAULT_COLLAPSED=false
VITE_HEADER_HEIGHT=64
VITE_FOOTER_HEIGHT=48

# ==============================================
# PERFORMANCE CONFIGURATION
# ==============================================
# Pagination settings
VITE_DEFAULT_PAGE_SIZE=25
VITE_MAX_PAGE_SIZE=100

# Cache settings
VITE_CACHE_ENABLED=true
VITE_CACHE_DURATION=300000

# ==============================================
# DEVELOPMENT TOOLS
# ==============================================
# Enable development tools
VITE_ENABLE_DEVTOOLS=true
VITE_ENABLE_QUERY_DEVTOOLS=true
VITE_ENABLE_PERFORMANCE_MONITOR=true

# Hot reload settings
VITE_HOT_RELOAD=true

# ==============================================
# LOGGING CONFIGURATION
# ==============================================
# Frontend logging
VITE_LOG_LEVEL=debug
VITE_ENABLE_CONSOLE_LOGS=true
VITE_ENABLE_ERROR_REPORTING=true

# ==============================================
# NETWORK CONFIGURATION
# ==============================================
# Request timeout settings
VITE_REQUEST_TIMEOUT=30000
VITE_UPLOAD_TIMEOUT=120000

# Retry configuration
VITE_REQUEST_RETRIES=3
VITE_RETRY_DELAY=1000

# ==============================================
# UPLOAD CONFIGURATION
# ==============================================
# File upload settings
VITE_MAX_FILE_SIZE=10485760
VITE_MAX_FILES=10
VITE_ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx

# ==============================================
# ANALYTICS CONFIGURATION
# ==============================================
# Analytics settings (optional)
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_TRACKING_ID=

# ==============================================
# SECURITY CONFIGURATION
# ==============================================
# Content Security Policy
VITE_CSP_ENABLED=false

# Enable HTTPS in development (optional)
VITE_HTTPS_ENABLED=false

# ==============================================
# LOCALIZATION
# ==============================================
# Language settings
VITE_DEFAULT_LOCALE=en
VITE_SUPPORTED_LOCALES=en,es,fr
VITE_FALLBACK_LOCALE=en

# ==============================================
# MAPPING CONFIGURATION
# ==============================================
# Map integration (if using maps)
VITE_MAP_ENABLED=true
VITE_MAP_API_KEY=your_map_api_key
VITE_MAP_DEFAULT_CENTER_LAT=13.1939
VITE_MAP_DEFAULT_CENTER_LNG=-59.5432

# ==============================================
# NOTIFICATION CONFIGURATION
# ==============================================
# Push notification settings
VITE_PUSH_NOTIFICATIONS_ENABLED=false
VITE_PUSH_VAPID_PUBLIC_KEY=

# Toast notification settings
VITE_TOAST_DURATION=5000
VITE_TOAST_POSITION=top-right

# ==============================================
# PRINT CONFIGURATION
# ==============================================
# Print and export settings
VITE_PRINT_ENABLED=true
VITE_EXPORT_ENABLED=true
VITE_EXPORT_FORMATS=pdf,excel,csv

# ==============================================
# ACCESSIBILITY CONFIGURATION
# ==============================================
# Accessibility features
VITE_A11Y_ENABLED=true
VITE_HIGH_CONTRAST_MODE=false
VITE_SCREEN_READER_OPTIMIZED=true

# ==============================================
# OFFLINE CONFIGURATION
# ==============================================
# Progressive Web App settings
VITE_PWA_ENABLED=true
VITE_OFFLINE_ENABLED=true
VITE_CACHE_STRATEGIES=networkFirst

# ==============================================
# TESTING CONFIGURATION
# ==============================================
# Test environment settings
VITE_TEST_API_URL=http://localhost:5001
VITE_TEST_MODE=false

# ==============================================
# BUILD CONFIGURATION
# ==============================================
# Build optimization
VITE_BUILD_SOURCEMAP=true
VITE_BUILD_MINIFY=false
VITE_BUILD_ANALYZE=false

# ==============================================
# DEVELOPMENT SERVER
# ==============================================
# Dev server configuration
VITE_DEV_SERVER_HOST=0.0.0.0
VITE_DEV_SERVER_PORT=3000
VITE_DEV_SERVER_OPEN=true

# ==============================================
# ERROR HANDLING
# ==============================================
# Error boundary configuration
VITE_ERROR_BOUNDARY_ENABLED=true
VITE_ERROR_REPORTING_ENABLED=true

# ==============================================
# PERFORMANCE MONITORING
# ==============================================
# Performance metrics
VITE_PERFORMANCE_MONITORING=true
VITE_RENDER_PERFORMANCE=true
VITE_BUNDLE_ANALYZER=false