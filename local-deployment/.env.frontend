# NiEMIS Frontend Environment Configuration for Local Deployment
# Copy this file to frontend/.env.local

# ======================
# API CONFIGURATION
# ======================
VITE_API_URL=https://localhost:5000/api
VITE_API_BASE_URL=https://localhost:5000
VITE_WEBSOCKET_URL=wss://localhost:5000

# ======================
# APPLICATION SETTINGS
# ======================
VITE_APP_NAME=NiEMIS
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=National Integrated Education Management Information System
VITE_APP_AUTHOR=Ministry of Educational Transformation - Barbados

# ======================
# ENVIRONMENT SETTINGS
# ======================
VITE_NODE_ENV=production
VITE_DEV_MODE=false
VITE_DEBUG_MODE=false

# ======================
# SECURITY SETTINGS
# ======================
VITE_ENABLE_HTTPS=true
VITE_SECURE_COOKIES=true
VITE_CSRF_PROTECTION=true

# ======================
# PERFORMANCE SETTINGS
# ======================
VITE_ENABLE_PWA=true
VITE_ENABLE_SERVICE_WORKER=true
VITE_CACHE_STRATEGY=networkFirst
VITE_PRELOAD_MODULES=true

# ======================
# MONITORING & ANALYTICS
# ======================
VITE_ENABLE_ANALYTICS=false
VITE_SENTRY_DSN=
VITE_GOOGLE_ANALYTICS_ID=

# ======================
# FEATURE FLAGS
# ======================
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_REAL_TIME_UPDATES=true

# ======================
# LOCAL DEVELOPMENT
# ======================
VITE_LOCAL_DEPLOYMENT=true
VITE_SSL_VERIFY=false
VITE_PROXY_TARGET=https://localhost:5000