# NiEMIS Frontend - Static File Serving and Caching Headers
# This file configures caching and security headers for static assets

# Cache static assets for 1 year
/static/*
  Cache-Control: public, max-age=31536000, immutable
  
# Cache HTML files for 1 hour
/*.html
  Cache-Control: public, max-age=3600, must-revalidate
  
# Cache service worker for 1 hour
/sw.js
  Cache-Control: public, max-age=3600, must-revalidate
  
# Cache manifest for 1 day
/manifest.json
  Cache-Control: public, max-age=86400, must-revalidate
  
# Cache images for 1 week
/images/*
  Cache-Control: public, max-age=604800, must-revalidate
  
# Cache fonts for 1 year
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  
# Security headers for all files
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=('self'), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  
# Content Security Policy for production
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.amazonaws.com https://picsum.photos; connect-src 'self' https://niemis-backend.onrender.com http://localhost:5000 https://api.cloudflare.com wss://*.onrender.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  
# HSTS for HTTPS
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# CORS headers for API requests
/api/*
  Access-Control-Allow-Origin: https://niemis-backend.onrender.com
  Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization, X-Requested-With
  Access-Control-Allow-Credentials: false
  Access-Control-Max-Age: 86400