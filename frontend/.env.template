# ==============================================================================
# NiEMIS Frontend - Environment Configuration Template
# ==============================================================================
# This file contains all environment variables required for the NiEMIS frontend
# Copy this file to .env and fill in the appropriate values for your environment
# ==============================================================================

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================

# Application Information
VITE_APP_NAME=NiEMIS
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION="National Integrated Education Management Information System"

# Environment Type
VITE_NODE_ENV=development

# Application URLs
VITE_APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000/api

# ==============================================================================
# BACKEND API CONFIGURATION
# ==============================================================================

# Backend API Endpoints
VITE_API_BASE_URL=http://localhost:5000
VITE_API_VERSION=v1

# API Timeout Configuration
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3
VITE_API_RETRY_DELAY=1000

# ==============================================================================
# AUTHENTICATION CONFIGURATION
# ==============================================================================

# Token Configuration
VITE_TOKEN_STORAGE_KEY=niemis_token
VITE_REFRESH_TOKEN_STORAGE_KEY=niemis_refresh_token

# Session Management
VITE_SESSION_TIMEOUT=1800000
VITE_SESSION_WARNING_TIME=300000
VITE_AUTO_LOGOUT_ENABLED=true

# Student Session Security
VITE_STUDENT_SESSION_TIMEOUT=1800000
VITE_STUDENT_AUTO_LOGOUT_WARNING=300000

# ==============================================================================
# SECURITY CONFIGURATION
# ==============================================================================

# Content Security Policy
VITE_ENABLE_CSP=true
VITE_CSP_REPORT_URI=/api/security/csp-report
VITE_CSP_REPORT_ONLY=false

# Student Data Protection
VITE_ENABLE_STUDENT_DATA_ENCRYPTION=true
VITE_STUDENT_DATA_ENCRYPTION_KEY=your_frontend_encryption_key_here

# Security Headers
VITE_ENABLE_SECURITY_HEADERS=true
VITE_ENABLE_HSTS=true
VITE_ENABLE_FRAME_PROTECTION=true

# ==============================================================================
# ROLE-BASED ACCESS CONTROL
# ==============================================================================

# Role Configuration
VITE_SUPPORTED_ROLES=student,parent,teacher,admin,super_admin

# Student Access Controls
VITE_STUDENT_PROFILE_ACCESS_ONLY=true
VITE_STUDENT_DATA_EXPORT_DISABLED=true
VITE_STUDENT_CROSS_SCHOOL_ACCESS_DISABLED=true

# Parent Access Controls
VITE_PARENT_CHILDREN_ACCESS_ONLY=true
VITE_PARENT_TEACHER_CONTACT_ENABLED=true

# Teacher Access Controls
VITE_TEACHER_SCHOOL_ACCESS_ONLY=true
VITE_TEACHER_GRADE_MANAGEMENT_ENABLED=true

# ==============================================================================
# USER INTERFACE CONFIGURATION
# ==============================================================================

# Theme Configuration
VITE_DEFAULT_THEME=light
VITE_THEME_SWITCHING_ENABLED=true
VITE_CUSTOM_THEME_ENABLED=false

# Barbados Government Branding
VITE_BARBADOS_BRANDING_ENABLED=true
VITE_GOVERNMENT_LOGO_URL=/images/barbados-coat-of-arms.png
VITE_MINISTRY_LOGO_URL=/images/ministry-education-logo.png

# Layout Configuration
VITE_SIDEBAR_COLLAPSED_DEFAULT=false
VITE_RESPONSIVE_DESIGN_ENABLED=true
VITE_MOBILE_OPTIMIZED=true

# ==============================================================================
# STUDENT DASHBOARD CONFIGURATION
# ==============================================================================

# Student Dashboard Features
VITE_STUDENT_DASHBOARD_ENABLED=true
VITE_STUDENT_PROFILE_EDITING_ENABLED=false
VITE_STUDENT_GRADE_VIEWING_ENABLED=true
VITE_STUDENT_ATTENDANCE_VIEWING_ENABLED=true
VITE_STUDENT_SCHEDULE_VIEWING_ENABLED=true

# Student Privacy Controls
VITE_STUDENT_PHOTO_REQUIRED=false
VITE_STUDENT_CONTACT_INFO_HIDDEN=true
VITE_STUDENT_FAMILY_INFO_HIDDEN=true

# ==============================================================================
# ADMIN DASHBOARD CONFIGURATION
# ==============================================================================

# Admin Dashboard Features
VITE_ADMIN_DASHBOARD_ENABLED=true
VITE_ADMIN_SCHOOL_MANAGEMENT_ENABLED=true
VITE_ADMIN_USER_MANAGEMENT_ENABLED=true
VITE_ADMIN_REPORT_GENERATION_ENABLED=true

# System Administration
VITE_SYSTEM_METRICS_ENABLED=true
VITE_AUDIT_LOG_VIEWING_ENABLED=true
VITE_BACKUP_MANAGEMENT_ENABLED=true

# ==============================================================================
# NOTIFICATION CONFIGURATION
# ==============================================================================

# Toast Notifications
VITE_NOTIFICATIONS_ENABLED=true
VITE_NOTIFICATION_DURATION=5000
VITE_NOTIFICATION_POSITION=top-right

# Email Notifications
VITE_EMAIL_NOTIFICATIONS_ENABLED=true
VITE_EMAIL_NOTIFICATION_PREFERENCES=true

# SMS Notifications
VITE_SMS_NOTIFICATIONS_ENABLED=true
VITE_SMS_NOTIFICATION_PREFERENCES=true

# ==============================================================================
# PERFORMANCE CONFIGURATION
# ==============================================================================

# Caching Configuration
VITE_CACHE_ENABLED=true
VITE_CACHE_DURATION=3600000
VITE_CACHE_API_RESPONSES=true

# Image Optimization
VITE_IMAGE_OPTIMIZATION_ENABLED=true
VITE_IMAGE_LAZY_LOADING_ENABLED=true
VITE_IMAGE_WEBP_SUPPORT=true

# Bundle Optimization
VITE_CODE_SPLITTING_ENABLED=true
VITE_TREE_SHAKING_ENABLED=true

# ==============================================================================
# REPORTING AND ANALYTICS CONFIGURATION
# ==============================================================================

# Report Generation
VITE_REPORT_GENERATION_ENABLED=true
VITE_REPORT_EXPORT_FORMATS=pdf,excel,csv
VITE_REPORT_PRINTING_ENABLED=true

# Analytics
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_TRACKING_ID=

# User Behavior Tracking
VITE_USER_BEHAVIOR_TRACKING=false
VITE_ANONYMOUS_ANALYTICS=true

# ==============================================================================
# ACCESSIBILITY CONFIGURATION
# ==============================================================================

# Accessibility Features
VITE_ACCESSIBILITY_FEATURES_ENABLED=true
VITE_SCREEN_READER_SUPPORT=true
VITE_KEYBOARD_NAVIGATION_ENABLED=true
VITE_HIGH_CONTRAST_MODE_AVAILABLE=true

# Text and Font Configuration
VITE_FONT_SIZE_ADJUSTMENT_ENABLED=true
VITE_DYSLEXIA_FRIENDLY_FONT_AVAILABLE=true

# ==============================================================================
# INTERNATIONALIZATION CONFIGURATION
# ==============================================================================

# Language Support
VITE_DEFAULT_LANGUAGE=en
VITE_SUPPORTED_LANGUAGES=en,es
VITE_LANGUAGE_SWITCHING_ENABLED=true

# Regional Settings
VITE_DEFAULT_TIMEZONE=America/Barbados
VITE_DATE_FORMAT=DD/MM/YYYY
VITE_TIME_FORMAT=HH:mm

# Currency and Number Formatting
VITE_DEFAULT_CURRENCY=BBD
VITE_NUMBER_FORMAT=en-BB

# ==============================================================================
# BARBADOS EDUCATION SYSTEM CONFIGURATION
# ==============================================================================

# School System Configuration
VITE_EDUCATION_SYSTEM=barbados
VITE_SCHOOL_YEAR_FORMAT=YYYY-YYYY
VITE_CURRENT_SCHOOL_YEAR=2024-2025

# Caribbean Integration
VITE_CARIBBEAN_EXAM_INTEGRATION=true
VITE_CEC_INTEGRATION_ENABLED=true

# Parish and Zone Configuration
VITE_PARISH_BASED_ORGANIZATION=true
VITE_EDUCATION_ZONES_ENABLED=true

# ==============================================================================
# FEATURE FLAGS CONFIGURATION
# ==============================================================================

# Core Features
VITE_FEATURE_STUDENT_MANAGEMENT=true
VITE_FEATURE_TEACHER_MANAGEMENT=true
VITE_FEATURE_SCHOOL_MANAGEMENT=true
VITE_FEATURE_ATTENDANCE_TRACKING=true
VITE_FEATURE_GRADE_MANAGEMENT=true

# Advanced Features
VITE_FEATURE_RFID_INTEGRATION=true
VITE_FEATURE_HEALTH_RECORDS=true
VITE_FEATURE_FAMILY_SOCIAL_ASSESSMENT=true
VITE_FEATURE_TEACHER_EVALUATION=true

# Experimental Features
VITE_FEATURE_AI_INSIGHTS=false
VITE_FEATURE_PREDICTIVE_ANALYTICS=false
VITE_FEATURE_MOBILE_APP_INTEGRATION=false

# ==============================================================================
# DEVELOPMENT AND DEBUGGING CONFIGURATION
# ==============================================================================

# Development Mode
VITE_DEBUG_MODE=false
VITE_DEVELOPMENT_FEATURES_ENABLED=false

# Debugging Features
VITE_CONSOLE_LOGGING_ENABLED=false
VITE_PERFORMANCE_MONITORING=false
VITE_ERROR_BOUNDARY_DETAILS=false

# Testing Configuration
VITE_TESTING_MODE=false
VITE_MOCK_API_ENABLED=false
VITE_CYPRESS_TESTING=false

# ==============================================================================
# EXTERNAL SERVICE INTEGRATIONS
# ==============================================================================

# Maps and Location Services
VITE_MAPS_ENABLED=true
VITE_MAPS_API_KEY=your_maps_api_key_here
VITE_SCHOOL_LOCATION_MAPPING=true

# File Storage Services
VITE_FILE_UPLOAD_ENABLED=true
VITE_FILE_UPLOAD_MAX_SIZE=10485760
VITE_FILE_UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf

# External Educational Resources
VITE_EXTERNAL_RESOURCES_ENABLED=true
VITE_CURRICULUM_RESOURCES_URL=https://curriculum.moe.gov.bb

# ==============================================================================
# COMPLIANCE AND PRIVACY CONFIGURATION
# ==============================================================================

# GDPR Compliance
VITE_GDPR_COMPLIANCE_ENABLED=true
VITE_COOKIE_CONSENT_REQUIRED=true
VITE_DATA_PROCESSING_CONSENT_REQUIRED=true

# Student Privacy
VITE_STUDENT_PRIVACY_CONTROLS=true
VITE_PARENTAL_CONSENT_REQUIRED=true
VITE_STUDENT_DATA_ANONYMIZATION=true

# Legal Information
VITE_PRIVACY_POLICY_URL=https://niemis.gov.bb/privacy
VITE_TERMS_OF_SERVICE_URL=https://niemis.gov.bb/terms
VITE_COOKIE_POLICY_URL=https://niemis.gov.bb/cookies

# ==============================================================================
# MAINTENANCE AND SYSTEM STATUS
# ==============================================================================

# Maintenance Mode
VITE_MAINTENANCE_MODE=false
VITE_MAINTENANCE_MESSAGE="System is under maintenance. Please try again later."
VITE_MAINTENANCE_END_TIME=

# System Status
VITE_SYSTEM_STATUS_ENABLED=true
VITE_STATUS_PAGE_URL=https://status.niemis.gov.bb

# ==============================================================================
# PRODUCTION DEPLOYMENT CONFIGURATION
# ==============================================================================

# Production Environment
VITE_PRODUCTION_MODE=false
VITE_PRODUCTION_API_URL=https://api.niemis.gov.bb
VITE_PRODUCTION_CDN_URL=https://cdn.niemis.gov.bb

# Performance Monitoring
VITE_PERFORMANCE_MONITORING_ENABLED=false
VITE_ERROR_REPORTING_ENABLED=false

# Security in Production
VITE_PRODUCTION_SECURITY_STRICT=true
VITE_PRODUCTION_HTTPS_ONLY=true

# ==============================================================================
# RENDER.COM DEPLOYMENT CONFIGURATION
# ==============================================================================

# Render.com Configuration
VITE_RENDER_DEPLOYMENT=false
VITE_RENDER_EXTERNAL_URL=

# Static Site Configuration
VITE_STATIC_SITE_OPTIMIZATION=true
VITE_BUILD_OPTIMIZATION=true

# ==============================================================================
# BARBADOS GOVERNMENT INTEGRATION
# ==============================================================================

# Government Services Integration
VITE_GOVERNMENT_SERVICES_ENABLED=true
VITE_GOVERNMENT_ID_VERIFICATION=true
VITE_MINISTRY_INTEGRATION=true

# National ID System
VITE_NATIONAL_ID_INTEGRATION=true
VITE_NATIONAL_ID_VERIFICATION_REQUIRED=false

# ==============================================================================
# SOCIAL FEATURES CONFIGURATION
# ==============================================================================

# Communication Features
VITE_TEACHER_PARENT_MESSAGING=true
VITE_SCHOOL_ANNOUNCEMENTS=true
VITE_STUDENT_FORUMS=false

# Social Integration
VITE_SOCIAL_SHARING_ENABLED=false
VITE_SOCIAL_LOGIN_ENABLED=false

# ==============================================================================
# ADVANCED SECURITY CONFIGURATION
# ==============================================================================

# Input Validation
VITE_CLIENT_SIDE_VALIDATION=true
VITE_SANITIZE_USER_INPUT=true
VITE_XSS_PROTECTION=true

# CSRF Protection
VITE_CSRF_PROTECTION_ENABLED=true
VITE_CSRF_TOKEN_HEADER=X-CSRF-Token

# Rate Limiting (Client-side)
VITE_CLIENT_RATE_LIMITING=true
VITE_API_CALL_THROTTLING=true

# ==============================================================================
# DISASTER RECOVERY CONFIGURATION
# ==============================================================================

# Backup and Recovery
VITE_OFFLINE_MODE_ENABLED=true
VITE_LOCAL_STORAGE_BACKUP=true
VITE_SERVICE_WORKER_ENABLED=true

# Failover Configuration
VITE_FAILOVER_API_ENABLED=true
VITE_BACKUP_API_URL=https://backup-api.niemis.gov.bb

# ==============================================================================
# END OF CONFIGURATION
# ==============================================================================

# NOTE: Remember to:
# 1. All VITE_ prefixed variables are exposed to the client-side code
# 2. Never include sensitive information in frontend environment variables
# 3. Set proper values for production deployment
# 4. Regularly review and update configuration as needed
# 5. Ensure consistency between frontend and backend configurations