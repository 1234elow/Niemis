# NiEMIS Frontend Environment Variables
# Copy this file to .env.local and customize for your environment

# API Configuration
VITE_API_URL=http://localhost:5000/api

# Application Configuration
VITE_APP_NAME=NiEMIS
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=National Integrated Education Management Information System

# Environment
NODE_ENV=development
VITE_NODE_ENV=development

# Performance and Debugging
VITE_ENABLE_ANALYTICS=false
VITE_DEBUG_MODE=true
VITE_ENABLE_LOGGING=true

# Security
VITE_ENABLE_CSP=false
VITE_STRICT_MODE=false

# Features
VITE_ENABLE_OFFLINE_MODE=false
VITE_ENABLE_PWA=false
VITE_ENABLE_NOTIFICATIONS=true

# Education Domain Specific
VITE_SCHOOL_SYSTEM_NAME=Barbados Education System
VITE_DEFAULT_LANGUAGE=en
VITE_TIMEZONE=America/Barbados

# Student Data Protection
VITE_ENABLE_STUDENT_DATA_ENCRYPTION=true
VITE_STUDENT_SESSION_TIMEOUT=1800000

# RFID Integration
VITE_ENABLE_RFID_SCANNING=true
VITE_RFID_SCAN_INTERVAL=5000

# Render.com Production Configuration (do not modify)
# VITE_API_URL=https://your-backend-service.onrender.com/api
# NODE_ENV=production
# VITE_NODE_ENV=production
# VITE_DEBUG_MODE=false
# VITE_ENABLE_LOGGING=false
# VITE_ENABLE_CSP=true
# VITE_STRICT_MODE=true